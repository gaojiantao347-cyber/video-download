{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-download.local/contracts/schemas/update-settings-request.schema.json",
  "title": "UpdateSettingsRequest",
  "type": "object",
  "required": [
    "downloadDir",
    "maxConcurrentDownloads",
    "removeWatermark",
    "allowFallback",
    "enableSystemNotifications"
  ],
  "additionalProperties": false,
  "properties": {
    "downloadDir": {
      "type": "string",
      "minLength": 1
    },
    "maxConcurrentDownloads": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "removeWatermark": {
      "type": "boolean"
    },
    "allowFallback": {
      "type": "boolean"
    },
    "enableSystemNotifications": {
      "type": "boolean"
    }
  }
}
