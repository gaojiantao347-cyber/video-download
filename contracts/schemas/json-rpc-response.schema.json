{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-download.local/contracts/schemas/json-rpc-response.schema.json",
  "title": "JsonRpcResponse",
  "type": "object",
  "required": ["jsonrpc", "id"],
  "additionalProperties": false,
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "result": true,
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "data": true
      }
    }
  },
  "oneOf": [
    {
      "required": ["result"],
      "not": {
        "required": ["error"]
      }
    },
    {
      "required": ["error"],
      "not": {
        "required": ["result"]
      }
    }
  ]
}
